{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:worker": "wrangler dev --port 8787",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "lint": "vize lint",
    "check": "vize check",
    "fmt:check": "vize fmt --check"
  },
  "dependencies": {
    "@lucide/vue": "^1.23.0",
    "nuxt": "^4.4.8",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.8.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@vizejs/musea-mcp-server": "^0.243.0",
    "@vizejs/nuxt": "^0.263.0",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.6",
    "vitest": "^4.1.9",
    "vize": "^0.263.0",
    "wrangler": "^4.141.0"
  }
}
